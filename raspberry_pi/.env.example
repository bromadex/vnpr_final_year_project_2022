# Device Configuration
# Copy this to .env on your Raspberry Pi

API_BASE_URL=http://your-server-ip:8000/api
DEVICE_API_KEY=your-device-api-key-here
SPEED_LIMIT=60

# Camera settings
CAMERA_RESOLUTION=1920x1080

# Hardware pins (BCM numbering)
PIN_RED_LIGHT=17
PIN_YELLOW_LIGHT=27
PIN_GREEN_LIGHT=22
PIN_SPEED_IR_1=23
PIN_SPEED_IR_2=24
PIN_RED_IR=25

# Google Cloud Vision
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-api-key
